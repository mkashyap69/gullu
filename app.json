{
  "expo": {
    "name": "Money Plan",
    "slug": "money-plan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneyplan",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07060D",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.moneyplan",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Money Plan uses Face ID to lock your plan."
      }
    },
    "android": {
      "package": "app.moneyplan",
      "adaptiveIcon": {
        "backgroundColor": "#07060D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Money Plan uses Face ID to lock your plan."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07060D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F06A24"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.moneyplan",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MoneyPlanStatus",
              "displayName": "Goals",
              "description": "How many goals are on track, at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            },
            {
              "name": "MoneyPlanPayday",
              "displayName": "Payday",
              "description": "Your payday amount, ready to place.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            },
            {
              "name": "MoneyPlanGoal",
              "displayName": "One goal",
              "description": "One goal you pick.",
              "supportedFamilies": [
                "systemSmall"
              ],
              "android": null,
              "configuration": {
                "title": "Pick a goal",
                "parameters": {
                  "goal": {
                    "title": "Goal",
                    "type": "enum",
                    "dynamic": true,
                    "values": [
                      {
                        "name": "The goal that needs most",
                        "value": ""
                      }
                    ],
                    "default": ""
                  }
                }
              }
            },
            {
              "name": "MoneyPlanMoves",
              "displayName": "This month's moves",
              "description": "Which moves are done and what's next.",
              "supportedFamilies": [
                "systemMedium"
              ],
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
